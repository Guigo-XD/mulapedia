---
import Search from "../components/Search.astro";
import "../styles/global.css";
import { getCollection } from "astro:content";

import {
  Home,
  Star,
  FileText,
  ScrollText,
  Timer,
  Users,
  Crown,
  BarChart3,
  Trophy,
  ClipboardList,
  Crosshair,
  Map,
  Mic,
  Heart,
  HelpCircle,
  BookOpen,
  Ticket,
  Flag,
  Menu,
  Gamepad2,
  X,
  Swords,
  ChessQueen,
  Car,
  UserRoundGroup,
  UsersRound,  
  BuildingComplex,
} from "@lucide/astro";

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const h = href.replace(/\/$/, '') || '/';
  if (h === '/') return pathname === '/';
  return pathname === h || pathname.startsWith(h + '/');
}

interface Props {
  title: string;
  description?: string;
  showSidebars?: boolean;
}

const {
  title,
  description = "A enciclopédia não oficial da Tribo",
  showSidebars = true,
} = Astro.props;

const latestRight = (await getCollection("pages"))
  .sort((a, b) => {
    const da = a.data.updatedDate ? new Date(a.data.updatedDate).getTime() : 0;
    const db = b.data.updatedDate ? new Date(b.data.updatedDate).getTime() : 0;
    return db - da;
  })
  .slice(0, 4);

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | MulaPédia</title>
    <meta name="description" content={description} />
    <!-- Ícone da aba -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Header -->
    <header class="header">
      <a href="/" class="logo">
        <div class="logo-icon">🫏</div>
        <div class="logo-text">
          <h1>MulaPédia</h1>
          <span>Conhecimento de toda a Tribo</span>
        </div>
      </a>
      <button
        type="button"
        class="menu-toggle"
        id="menu-toggle"
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        ☰
      </button>
      <Search />

      <a href="/tribo/cultura" class="tribo-btn">
        👑 A Tribo
        <span style="font-size:11px;opacity:0.8">Juntos somos mais fortes</span>
      </a>
    </header>

    <!-- Navigation -->
    <nav class="nav">
      <a href="/"><Home size={16} class="nav-icon" /> Início</a>
      <a href="/g3x/historia"><ScrollText size={16} class="nav-icon" /> G3X</a>
      <a href="/g3x/elencos"><Users size={16} class="nav-icon" /> Elencos</a>
      <a href="/kings-league/overview"><Crown size={16} class="nav-icon" /> Kings</a>
      <a href="/cs2/overview"><Crosshair size={16} class="nav-icon" /> CS2</a>
      <a href="/gaules/biografia"><Mic size={16} class="nav-icon" /> Gaules</a>
      <a href="/tribo/cultura"><Heart size={16} class="nav-icon" /> Tribo</a>
      <a href="/tribo/faq"><HelpCircle size={16} class="nav-icon" /> FAQ</a>
      <a href="/artigos"><FileText size={16} class="nav-icon" /> Artigos</a>
      <a href="/tribo/faq"><HelpCircle size={16} class="nav-icon" /> FAQ</a>
    </nav>

    <!-- Main Layout -->
    <div class:list={["container", !showSidebars && "container--single"]}>
      {
        showSidebars && (
          <aside class="sidebar-left">
            <div class="sidebar-title">
              <Star size={16} stroke-width={2} />
              <span>Explorar a Tribo</span>
            </div>

           <a href="/" class:list={['nav-link', { active: isActive('/') }]}>
              <Home size={18} class="nav-icon" /> Início
            </a>
            <a href="/areas"class:list={['nav-link', { active: isActive('/areas') }]}>
              <Star size={18} class="nav-icon" /> Áreas
            </a>
            <a href="/artigos"class:list={['nav-link', { active: isActive('/artigos') }]}>
              <FileText size={18} class="nav-icon" /> Artigos
            </a>

            <div class="sidebar-title">
              <Gamepad2 size={16} stroke-width={2} />
              <span>G3X</span>
            </div>
            <a href="/g3x/historia"class:list={['nav-link', { active: isActive('/g3x/historia') }]}>
              <ScrollText size={18} class="nav-icon" /> História
            </a>
            <a href="/g3x/elencos"class:list={['nav-link', { active: isActive('/g3x/elencos') }]}>
              <Users size={18} class="nav-icon" /> Elencos
            </a>
            <a href="/g3x/ct"class:list={['nav-link', { active: isActive('/g3x/ct') }]}>
              <BuildingComplex size={18} class="nav-icon" /> CT do Povo
            </a>
            <a href="/g3x/resultados"class:list={['nav-link', { active: isActive('/g3x/resultados') }]}>
              <BarChart3 size={18} class="nav-icon" /> Resultados
            </a>
            <a href="/g3x/titulos"class:list={['nav-link', { active: isActive('/g3x/titulos') }]}>
              <Trophy size={18} class="nav-icon" /> Títulos
            </a>

            <div class="sidebar-title">
              <Swords size={16} class="nav-icon" /> Competições
            </div>
            <a href="/kings-league/overview"class:list={['nav-link', { active: isActive('/kings-league/overview') }]}>
              <Crown size={18} class="nav-icon" /> Kings League
            </a>
            <a href="/cs2/overview"class:list={['nav-link', { active: isActive('/cs2/overview') }]}>
              <Crosshair size={18} class="nav-icon" /> CS2
            </a>
            <a href="/g3x/racing"class:list={['nav-link', { active: isActive('/g3x/racing') }]}>
              <Car size={18} class="nav-icon" /> G3X Racing
            </a>
            <a href="/queens-league/overview"class:list={['nav-link', { active: isActive('/queens-league/overview') }]}>
              <ChessQueen size={18} class="nav-icon" /> Queens League
            </a>

            <div class="sidebar-title">
              <Heart size={16} class="nav-icon" /> Tribo
            </div>
            <a href="/gaules/biografia"class:list={['nav-link', { active: isActive('/gaules/biografia') }]}>
              <Mic size={18} class="nav-icon" /> Gaules
            </a>
            <a href="/tribo/cultura"class:list={['nav-link', { active: isActive('/tribo/cultura') }]}>
              <Heart size={18} class="nav-icon" /> Cultura
            </a>
            <a href="/tribo/faq"class:list={['nav-link', { active: isActive('/tribo/faq') }]}>
              <HelpCircle size={18} class="nav-icon" /> FAQ
            </a>
            <a href="/glossario"class:list={['nav-link', { active: isActive('/glossario') }]}>
              <BookOpen size={18} class="nav-icon" /> Glossário
            </a>
            <a href="/tribo/socio-sofredor"class:list={['nav-link', { active: isActive('/tribo/socio-sofredor') }]}>
              <UserRoundGroup size={18} class="nav-icon" /> Sócio Sofredor
            </a>

            <div style="margin-top:28px;padding:16px;background:#1e293b;border-radius:12px;text-align:center;">
              <div style="font-size:22px;font-weight:800;color:#60a5fa;">
                TRIBO
              </div>
              <p style="font-size:12px;color:#94a3b8;margin-top:8px;line-height:1.45;">
                É mais que um time.
                <br />
                <strong style="color:#fbbf24">É uma família.</strong>
              </p>
              <p style="font-size:11px;color:#64748b;margin-top:8px;">
                “A Tribo cuida da Tribo”
              </p>
            </div>
          </aside>
        )
      }

      <!-- Main Content -->
      <main class="main">
        <slot />
      </main>

      <!-- Right Sidebar -->
      {
        showSidebars && (
          <aside class="sidebar-right">
            <div class="sidebar-title">
              <Star size={15} stroke-width={2} />
              <span>Em destaque</span>
            </div>

            <a href="/g3x/resultados-kings" class="right-card">
              <div class="right-card-icon">
                <Trophy size={18} stroke-width={2} />
              </div>
              <div class="right-card-body">
                <strong>Mundial 2026</strong>
                <span>G3X FC campeão em Milão — 9×5 Alpak</span>
              </div>
            </a>

            <a href="/gaules/biografia" class="right-card">
              <div class="right-card-icon">
                <Mic size={18} stroke-width={2} />
              </div>
              <div class="right-card-body">
                <strong>Gaules</strong>
                <span>Biografia do líder da Tribo</span>
              </div>
            </a>

            <a href="/tribo/faq" class="right-card">
              <div class="right-card-icon">
                <HelpCircle size={18} stroke-width={2} />
              </div>
              <div class="right-card-body">
                <strong>FAQ</strong>
                <span>Perguntas frequentes da comunidade</span>
              </div>
            </a>

            <a href="/g3x/elencos" class="right-card">
              <div class="right-card-icon">
                <Users size={18} stroke-width={2} />
              </div>
              <div class="right-card-body">
                <strong>Elencos</strong>
                <span>Kings · CS2 · Queens</span>
              </div>
            </a>

            <div class="sidebar-title" style="margin-top:22px;">
              <FileText size={15} stroke-width={2} />
              <span>Recentes</span>
            </div>

            <div class="right-list">
              {latestRight.map((item) => (
                <a href={`/${item.id}`} class="right-list-item">
                  <span class="right-list-title">{item.data.title}</span>
                  <span class="right-list-meta">
                    {item.data.section || "Geral"}
                  </span>
                </a>
              ))}
            </div>

            <a href="/artigos" class="right-more">
              Ver todos os artigos →
            </a>

            <div class="sidebar-title" style="margin-top:22px;">
              <Crown size={15} stroke-width={2} />
              <span>Atalhos</span>
            </div>

            <div class="right-shortcuts">
              <a href="/g3x/resultados">Resultados</a>
              <a href="/g3x/titulos">Títulos</a>
              <a href="/kings-league/regras">Regras Kings</a>
              <a href="/g3x/racing">Racing</a>
              <a href="/glossario">Glossário</a>
              <a href="/tribo/socio-sofredor">Sócio Sofredor</a>
            </div>
          </aside>
        )
      }
    </div>

    <footer class="footer">
      <div style="margin-bottom:8px;">
        <strong>MulaPédia</strong> — Conhecimento de toda a Tribo
      </div>
      <div class="footer-inner">      
        <nav class="footer-nav">
          <a href="/sobre">Sobre</a>
          <a href="/changelog">Changelog</a>
          <a href="/tribo/faq">FAQ</a>
          <a href="/tribo/streamers">Streamers</a>
          <a href="/g3x/resultados">Resultados</a>
        </nav>
      </div>
      <div style="font-size:12px;opacity:0.75;">
        👑 Feita pela comunidade, para a comunidade.<br />
        Conteúdo baseado em fatos reais até outubro de 2026.<br />
        Projeto conceitual — não oficial.
      </div>
    </footer>

    <!-- Menu mobile -->
    <div class="mobile-nav-backdrop" id="menu-backdrop"></div>

    <nav class="mobile-nav" id="mobile-nav" aria-hidden="true">
      <div class="mobile-nav-header">
        <strong>Explorar a Tribo</strong>
        <button
          type="button"
          class="mobile-nav-close"
          id="menu-close"
          aria-label="Fechar menu"
        >
          <X size={18} stroke-width={2} />
        </button>
      </div>

      <a href="/"><Home size={18} class="nav-icon" /> Início</a>
      <a href="/areas"><Star size={18} class="nav-icon" /> Áreas</a>
      <a href="/artigos"><FileText size={18} class="nav-icon" /> Artigos</a>

      <div class="sidebar-title">
        <Gamepad2 size={16} class="nav-icon" /> G3X
      </div>
      <a href="/g3x/historia"
        ><ScrollText size={18} class="nav-icon" /> História</a
      >
      <a href="/g3x/elencos"><Users size={18} class="nav-icon" /> Elencos</a>
      <a href="/g3x/ct"
        ><BuildingComplex size={18} class="nav-icon" /> CT do Povo</a>

      <a href="/g3x/resultados"
        ><BarChart3 size={18} class="nav-icon" /> Resultados</a
      >
      <a href="/g3x/titulos"><Trophy size={18} class="nav-icon" /> Títulos</a>

      <div class="sidebar-title">
        <Swords size={16} class="nav-icon" /> Competições
      </div>
      <a href="/kings-league/overview"
        ><Crown size={18} class="nav-icon" /> Kings League</a
      >
      <a href="/cs2/overview"><Crosshair size={18} class="nav-icon" /> CS2</a>
      <a href="/g3x/racing"><Car size={18} class="nav-icon" /> G3X Racing</a>
      <a href="/queens-league/overview"
        ><ChessQueen size={18} class="nav-icon" /> Queens League</a
      >

      <div class="sidebar-title">
        <Heart size={16} class="nav-icon" /> Tribo
      </div>
      <a href="/gaules/biografia"><Mic size={18} class="nav-icon" /> Gaules</a>
      <a href="/tribo/cultura"><Heart size={18} class="nav-icon" /> Cultura</a>
      <a href="/tribo/faq"><HelpCircle size={18} class="nav-icon" /> FAQ</a>
      <a href="/glossario"><BookOpen size={18} class="nav-icon" /> Glossário</a>
      <a href="/tribo/socio-sofredor"
        ><UsersRound size={18} class="nav-icon" /> Sócio Sofredor</a
      >
    </nav>

    <script>
      const toggle = document.getElementById("menu-toggle");
      const closeBtn = document.getElementById("menu-close");
      const nav = document.getElementById("mobile-nav");
      const backdrop = document.getElementById("menu-backdrop");

      function openMenu() {
        nav?.classList.add("open");
        backdrop?.classList.add("open");
        document.body.classList.add("menu-open");
        nav?.setAttribute("aria-hidden", "false");
        toggle?.setAttribute("aria-expanded", "true");
      }

      function closeMenu() {
        nav?.classList.remove("open");
        backdrop?.classList.remove("open");
        document.body.classList.remove("menu-open");
        nav?.setAttribute("aria-hidden", "true");
        toggle?.setAttribute("aria-expanded", "false");
      }

      toggle?.addEventListener("click", openMenu);
      closeBtn?.addEventListener("click", closeMenu);
      backdrop?.addEventListener("click", closeMenu);

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeMenu();
      });
    </script>
  </body>
</html>
