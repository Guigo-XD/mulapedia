---
import Layout from "../../layouts/Layout.astro";
import TitleCard from "../../components/TitleCard.astro";
import data from "../../data/titulos.json";

const items = data.items;
const champs = items.filter((i) => i.result === "champion");
const gallery = [...items].sort((a, b) => b.year - a.year);
---

<Layout
  title="Títulos do G3X"
  description="Conquistas do G3X — Kings League, Supercopa Desimpedidos, CS e a trajetória até o Mundial de 2026"
>
  <article class="content-page" data-pagefind-body>
    <div class="info-box">
      <strong>G3X</strong> — do CS 1.6 ao título mundial de clubes na Kings League.<br />
      Inclui a <strong>Supercopa Desimpedidos 2024</strong>, primeiro troféu no fut7.<br />
      <strong>Atualizado:</strong> {data.updated}
    </div>

    <p>
      <a href="/g3x/historia">História</a> ·
      <a href="/g3x/resultados">Resultados</a> ·
      <a href="/g3x/elencos">Elencos</a>
    </p>

    <h2 id="galeria">Galeria de títulos</h2>

    <div class="titles-gallery">
      {
        gallery.map((t) => (
          <TitleCard
            year={t.year}
            name={t.name}
            badge={t.badge}
            meta={t.meta}
            href={t.href}
            featured={t.featured}
            result={t.result}
          />
        ))
      }
    </div>

    <h2 id="por-ano">Linha de conquistas</h2>

    <div class="titles-years">
      {
        gallery.map((t) => (
          <div
            class:list={[
              "titles-year-row",
              { "is-gold": t.result === "champion" },
            ]}
          >
            <div class="titles-year-label">{t.year}</div>
            <div class="titles-year-body">
              <h4>
                {t.result === "champion" && "Campeão — "}
                {t.result === "runner-up" && "Vice — "}
                {t.name}
              </h4>
              <p>{t.meta}</p>
            </div>
          </div>
        ))
      }
    </div>

    <h2>Detalhes dos títulos de fut7</h2>

    {
      items
        .filter((t) => t.detail && (t.id.includes("2026") || t.id.includes("desimpedidos") || t.id.includes("mundial-clubes")))
        .map((t) => (
          <section style="margin-bottom: 2rem;">
            <h3>
              {t.year} — {t.name}
            </h3>
            <table class="wiki-table">
              <thead>
                <tr>
                  <th>Item</th>
                  <th>Detalhe</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    <strong>Resultado</strong>
                  </td>
                  <td>{t.badge}</td>
                </tr>
                <tr>
                  <td>
                    <strong>Local</strong>
                  </td>
                  <td>{t.detail?.local}</td>
                </tr>
                <tr>
                  <td>
                    <strong>Data</strong>
                  </td>
                  <td>{t.detail?.date}</td>
                </tr>
                <tr>
                  <td>
                    <strong>Placar / status</strong>
                  </td>
                  <td>{t.detail?.score}</td>
                </tr>
                <tr>
                  <td>
                    <strong>Notas</strong>
                  </td>
                  <td>{t.detail?.notes}</td>
                </tr>
              </tbody>
            </table>
          </section>
        ))
    }

    <h2>Supercopa Desimpedidos 2024</h2>
    <div class="info-box">
      Primeiro título oficial do <strong>G3X FC</strong> no fut7.
      Final em 17 de novembro de 2024, na Mercado Livre Arena Pacaembu, contra a
      <strong>FURIA</strong> (3×2). Kelvin Oliveira marcou o gol do título;
      Andreas Vaz também balançou as redes na decisão.
    </div>

    <h2>Individuais (Mundial 2026)</h2>
    <div class="players-grid">
      <a href="/g3x/jogadores/kelvin-oliveira" class="player-card" style="text-decoration:none;color:inherit;">
        <img src="/players/k9.jpg" alt="Kelvin Oliveira" />
        <div class="info">
          <div class="name">Kelvin Oliveira</div>
          <div class="position">Artilheiro KWC Clubs 2026</div>
          <span class="badge gold">14 gols</span>
        </div>
      </a>
      <a href="/g3x/jogadores/andreas-vaz" class="player-card" style="text-decoration:none;color:inherit;">
        <div class="placeholder" aria-hidden="true">
          <span class="placeholder-initials">AV</span>
        </div>
        <div class="info">
          <div class="name">Andreas Vaz</div>
          <div class="position">MVP KWC Clubs 2026</div>
          <span class="badge gold">MVP</span>
        </div>
      </a>
    </div>

    <h2>Nesta seção</h2>
    <div class="cards-grid" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
      <a href="/g3x/resultados" class="card section-nav-card" style="text-decoration:none;color:inherit;">
        <div class="card-body">
          <h4><span class="section-nav-label">Res</span> Resultados</h4>
          <p>Hub de todas as modalidades</p>
        </div>
      </a>
      <a href="/g3x/resultados-kings" class="card section-nav-card" style="text-decoration:none;color:inherit;">
        <div class="card-body">
          <h4><span class="section-nav-label green">KL</span> Kings</h4>
          <p>Placares e campanhas</p>
        </div>
      </a>
      <a href="/g3x/historia" class="card section-nav-card" style="text-decoration:none;color:inherit;">
        <div class="card-body">
          <h4><span class="section-nav-label">Hist</span> História</h4>
          <p>2001 → 2026</p>
        </div>
      </a>
      <a href="/g3x/elencos" class="card section-nav-card" style="text-decoration:none;color:inherit;">
        <div class="card-body">
          <h4><span class="section-nav-label">Team</span> Elencos</h4>
          <p>Quem ergueu as taças</p>
        </div>
      </a>
    </div>
  </article>
</Layout>